      {"kind": "edge", "args": ["--bom", "tests/fixtures/takeoff-to-quote/header-only.csv", "--catalogue", "tests/fixtures/takeoff-to-quote/catalogue.csv", "--date", "2026-11-05"],
       "expect_exit": [0], "expect_stdout": ["The BOM has no lines", "**0.00**"]},
      {"kind": "edge", "args": ["--bom", "tests/fixtures/takeoff-to-quote/bad-bom.csv", "--catalogue", "tests/fixtures/takeoff-to-quote/bad-catalogue.csv", "--waste", "plugins/fulcrum-trades-field/skills/takeoff-to-quote/assets/waste-allowances.csv", "--labour", "tests/fixtures/takeoff-to-quote/labour.csv", "--stock", "tests/fixtures/takeoff-to-quote/stock.csv", "--date", "2026-11-05", "--format", "json"],
       "expect_exit": [1], "expect_stdout": ["\"status\": \"INCOMPLETE\"", "\"subtotal\": \"227.80\"", "'qty' is not a number: 'abc'"], "expect_stderr": ["'NaN'. Catalogue row skipped.", "coverage and pack_size must be greater than zero"]},
      {"kind": "edge", "args": ["--bom", "plugins/fulcrum-trades-field/skills/takeoff-to-quote/assets/bom-template.csv", "--catalogue", "plugins/fulcrum-trades-field/skills/takeoff-to-quote/assets/catalogue-template.csv", "--waste", "plugins/fulcrum-trades-field/skills/takeoff-to-quote/assets/waste-allowances.csv", "--labour", "plugins/fulcrum-trades-field/skills/takeoff-to-quote/assets/labour-rates-template.csv", "--stock", "plugins/fulcrum-trades-field/skills/takeoff-to-quote/assets/stock-on-hand-template.csv", "--date", "2026-11-05"],
       "expect_exit": [1], "expect_stdout": ["INCOMPLETE: 8 missing"], "expect_stderr": ["stock row 2: 'on_hand' is blank"]}
