       "expect_exit": [0],
       "expect_stdout": ["(COMPLETE)", "| 34 sheet | Example Building Supplies | 18.50 | 723.35 | 21.60 | 1620.00 |", "| Materials (ex GST) | 2,248.02 |", "**9,967.02**", "| GST | 996.70 |", "**10,963.72**", "| EX-PB-10 | Plasterboard 10mm 2400x1200 | 4 | sheet | 18.50 | 74.00 | 1 |", "valid until 2026-11-20, before the quote expires on 2026-12-05"]},
