    {"kind": "edge", "args": ["plugins/fulcrum-pa-core/skills/invoice-chasing/assets/sample-receivables.csv", "--as-of", "5/11/2026"], "expect_exit": [2], "expect_stderr": ["--as-of must be a date in YYYY-MM-DD form"]}
